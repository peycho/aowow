# Disable directory listing without changing the host's PHP or symlink settings.
# Configure Options -MultiViews in the virtual host (see README.md).
Options -Indexes
AddDefaultCharset utf-8
AcceptPathInfo Off

# Legacy charset module compatibility.
<IfModule mod_charset.c>
    CharsetDisable on
    CharsetRecodeMultipartForms Off
</IfModule>

# PHP-FPM deployments set these limits in their PHP configuration.
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

RewriteEngine On

# Deny hidden files and directories.
RewriteRule (^|/)\. - [F,L]

# Pending and temporary uploads require authenticated endpoints.
RewriteRule ^static/uploads/(?:screenshots/(?:pending|temp)|temp)(?:/|$) - [F,L,NC]

# Public entrypoint and approved assets.
RewriteRule ^(?:index\.php|robots\.txt|crossdomain\.xml)$ - [L,NC]
RewriteRule ^static(?:/|$) - [L,NC]
RewriteRule ^$ index.php [L]

# Deny source code, private configuration, caches and other root paths.
RewriteRule ^ - [F,L]
