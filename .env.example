# Copy to .env, chmod 600 .env, and replace blank passwords before starting.
# Default: local AoWoW MySQL; existing external TrinityCore world database.
# For both local MySQL instances: COMPOSE_PROFILES=local-db,trinity-db
# For all databases external: COMPOSE_PROFILES=
COMPOSE_PROFILES=local-db
COMPOSE_PROJECT_NAME=aowow
AOWOW_IMAGE=aowow:local
PHP_IMAGE=php:8.5-apache-trixie
COMPOSER_IMAGE=composer:2
MYSQL_IMAGE=mysql:8.4

# Local host ports for this checkout use 8010-8020. MySQL ports are unpublished.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8010
TZ=UTC
PHP_MEMORY_LIMIT=1536M
PHP_MAX_EXECUTION_TIME=120
# Budget memory for this many PHP workers plus MySQL and CLI generators.
APACHE_MAX_REQUEST_WORKERS=4

# Root credentials are only needed for enabled local database services.
MYSQL_ROOT_PASSWORD=
MYSQL_ROOT_PASSWORD_FILE=
TRINITY_MYSQL_ROOT_PASSWORD=
TRINITY_MYSQL_ROOT_PASSWORD_FILE=

# AoWoW application DB: read/write/schema permissions within this database only.
# The official MySQL image creates this DB/user and imports SQL 01-03 ONCE.
AOWOW_DB_HOST=db
AOWOW_DB_PORT=3306
AOWOW_DB_NAME=aowow
AOWOW_DB_USER=aowow
AOWOW_DB_PASSWORD=
AOWOW_DB_PASSWORD_FILE=

# Required compatible TrinityCore world database: SELECT only.
# Replace trinity-db with the external server hostname for the default profile.
WORLD_DB_HOST=trinity-db
WORLD_DB_PORT=3306
WORLD_DB_NAME=world
WORLD_DB_USER=aowow_reader
WORLD_DB_PASSWORD=
WORLD_DB_PASSWORD_FILE=

# Optional auth: leave NAME empty to disable. SELECT only.
AUTH_DB_HOST=trinity-db
AUTH_DB_PORT=3306
AUTH_DB_NAME=
AUTH_DB_USER=aowow_reader
AUTH_DB_PASSWORD=
AUTH_DB_PASSWORD_FILE=

# Optional characters: leave NAME empty to disable. SELECT only.
# Realm ID must match auth.realmlist.id. Extra realms live in config/config.php.
CHARACTERS_DB_HOST=trinity-db
CHARACTERS_DB_PORT=3306
CHARACTERS_DB_NAME=
CHARACTERS_DB_USER=aowow_reader
CHARACTERS_DB_PASSWORD=
CHARACTERS_DB_PASSWORD_FILE=

# *_PASSWORD_FILE values refer to paths INSIDE containers, not host paths.
# Add Compose secret mounts as shown in docs/docker.md. Set either PASSWORD or
# PASSWORD_FILE, never both. Config is generated once; refresh changes explicitly.
