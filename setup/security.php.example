<?php

// Copy to config/security.php; keep that file and its directory deployment-owned,
// readable by PHP-FPM but not writable by PHP-FPM or neighboring sites.
if (!defined('AOWOW_REVISION'))
    die('illegal access');

// Generate a unique per-installation value with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
// Never commit the generated value. Missing/invalid keys disable response caching.
define('AOWOW_CACHE_KEY', 'REPLACE_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS');

// Optional: absolute, deployment-owned PHP >= 8.4 CLI binary matching the site's extensions/config.
// The default is PHP_BINDIR/php (PHP_BINDIR/php.exe on Windows); no PATH search is performed.
// define('AOWOW_PHP_CLI', '/absolute/path/to/php');

// Required only for browser PHP diagnostics and site configuration (including add/remove/update).
// Empty/missing/malformed policies deny those routes. Existing login/role/CSRF checks still apply.
// List up to 64 exact operator IPv4/IPv6 addresses, without CIDRs, wildcards, ports or forwarded headers.
// Replace this empty list in config/security.php; do not enable access for a shared reverse proxy's IP.
define('AOWOW_OPERATOR_IPS', []);

// Optional Cloudflare Turnstile. Configure the widget's allowed hostname in Cloudflare.
// Keep the secret here, never in a database setting, generated JavaScript or version control.
// Form switches under Site Configuration remain disabled until explicitly enabled.
define('AOWOW_TURNSTILE_SITE_KEY', '');
define('AOWOW_TURNSTILE_SECRET_KEY', '');

// Outgoing account mail: mail (existing PHP transport), smtp, or disabled.
// Keep credentials in this private file. SMTP bypasses PHP's sendmail_path;
// explicitly choose disabled on development installations that must not send mail.
define('AOWOW_MAIL', [
    'transport'       => 'mail',
    'host'            => 'smtp.gmail.com',
    'port'            => 587,
    'encryption'      => 'tls',       // tls: STARTTLS; ssl: implicit TLS (usually 465); none: unauthenticated relay only
    'auth'            => true,
    'username'        => '',          // Gmail: full account email address
    'password'        => '',          // Gmail: app password; never commit real credentials
    'auth_type'       => '',          // automatic; optionally LOGIN, PLAIN or CRAM-MD5
    'from_email'      => '',          // empty: CONTACT_EMAIL; Gmail requires the account or an authorized alias
    'from_name'       => '',          // empty: NAME_SHORT
    'reply_to'        => '',          // empty: CONTACT_EMAIL
    'timeout'         => 10,          // connection/socket timeout, seconds (1–30)
    'command_timeout' => 10,          // SMTP command time limit, seconds (1–30; final DATA acknowledgment allows twice this)
    'ca_file'         => ''           // optional trusted CA bundle path; certificate/hostname verification stays enabled
]);
