# make dev-init copies this to .env.dev and generates independent passwords.
# Never point this stack at production databases.
COMPOSE_PROJECT_NAME=aowow-dev
COMPOSE_PROFILES=local-db,trinity-db
AOWOW_IMAGE=aowow:local
AOWOW_DEV_IMAGE=aowow:dev
NODE_IMAGE=node:24-trixie-slim
MYSQL_IMAGE=mysql:8.4
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8011
TZ=UTC
PHP_MEMORY_LIMIT=1536M
PHP_MAX_EXECUTION_TIME=120
APACHE_MAX_REQUEST_WORKERS=2
MYSQL_ROOT_PASSWORD=
TRINITY_MYSQL_ROOT_PASSWORD=
AOWOW_DB_HOST=db
AOWOW_DB_PORT=3306
AOWOW_DB_NAME=aowow
AOWOW_DB_USER=aowow
AOWOW_DB_PASSWORD=
WORLD_DB_HOST=trinity-db
WORLD_DB_PORT=3306
WORLD_DB_NAME=world
WORLD_DB_USER=aowow_reader
WORLD_DB_PASSWORD=
AUTH_DB_NAME=
CHARACTERS_DB_NAME=
